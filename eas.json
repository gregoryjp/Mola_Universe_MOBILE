{
  "cli": {
    "version": ">= 5.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://preview-api.mola.app/api"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "android": {
        "buildType": "aab"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mola.app/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6737000000",
        "appleId": "deploy@mola.app",
        "appleTeamId": "XXXXX",
        "appleIdPassword": "@env APPLE_ID_PASSWORD"
      },
      "android": {
        "serviceAccount": "@env ANDROID_SERVICE_ACCOUNT"
      }
    }
  }
}
