# Copy to .env and fill in real values. Never commit .env.
# Backend base URL — Mola_Universe_APP is the source of truth for available routes.
# Currently served under the legacy /api prefix (see docs/api-contracts.md).
API_URL=http://localhost:3000/api
API_TIMEOUT_MS=10000

# RevenueCat (billing) — public SDK keys, one per platform.
# No existing key names were found in Mola_Universe_APP at scaffold time; confirm the
# real key names with the backend/billing owner before wiring this up.
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
