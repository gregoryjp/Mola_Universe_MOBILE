# Copy to .env and fill in real values. Never commit .env.
#
# Client-exposed variables MUST be prefixed with EXPO_PUBLIC_ — Expo inlines them
# into the bundle at build time. Anything with that prefix is PUBLIC: never put
# secrets, private keys, or server-only config here.
#
# Backend base URL — Mola_Universe_APP is the source of truth for available routes.
# Served under /api/v1 (legacy /api alias retained; see docs/api-contracts.md).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# RevenueCat (billing) — public SDK keys, one per platform (client-exposed).
# No existing key names were found in Mola_Universe_APP at scaffold time; confirm the
# real key names with the backend/billing owner before wiring this up.
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
